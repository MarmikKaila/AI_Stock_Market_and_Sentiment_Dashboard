# ========================================
# AI Stock Market Sentiment Dashboard
# Environment Variables Configuration
# ========================================

# 🔐 REQUIRED: Database Connection
# Create free cluster at: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/dbname
MONGO_URI=mongodb+srv://your_username:your_password@your-cluster.mongodb.net/stock-dashboard?retryWrites=true&w=majority

# 🤖 REQUIRED: Google Gemini API Key
# Get free key at: https://aistudio.google.com/app/apikey
# No credit card needed - free tier available
GEMINI_API_KEY=your_gemini_api_key_here

# 📈 REQUIRED: Alpha Vantage API Key
# Stock fundamentals, prices, historical data
# Get free key at: https://www.alphavantage.co/support/#api-key
# Free tier: 5 calls/min, 500/day
ALPHA_VANTAGE_API_KEY=demo

# 📰 REQUIRED: NewsAPI Key
# Latest financial news headlines
# Get free key at: https://newsapi.org/register
# Free tier: 100 requests/day
NEWSAPI_KEY=your_newsapi_key_here

# 🔑 OPTIONAL: Cohere API Key (future use)
# Reserved for future AI model strategy
# Get key at: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_api_key_here

# 🖥️ OPTIONAL: Server Configuration
# Port for Express server (default: 5000)
PORT=5000

# 🌍 OPTIONAL: CORS Origins (comma-separated)
# Allowed frontend origins for CORS
# Default: http://localhost:5173,http://localhost:3000
# Production: https://youromain.com,https://app.yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 📍 OPTIONAL: Node Environment
# Options: development, production, test
NODE_ENV=development

# ========================================
# AWS DEPLOYMENT (Optional - for AWS only)
# ========================================
# AWS_REGION=us-east-1
# AWS_LAMBDA_FUNCTION_NAME=stock-dashboard
# RDS_ENDPOINT=db-instance.us-east-1.rds.amazonaws.com
# RDS_PORT=5432

# ========================================
# NOTES FOR SECURITY
# ========================================
# ✅ Never commit .env file to git (use .env.example)
# ✅ Rotate API keys every 90 days
# ✅ Use separate keys for dev/prod
# ✅ Store real .env files in secure vaults (AWS Secrets Manager in production)
# ✅ In production, use environment variable injection from CI/CD pipeline
